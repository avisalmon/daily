# Keep line endings stable across Windows checkouts.
* text=auto eol=lf

# Encoding matters here (Hebrew content). Never let a tool "fix" these.
*.json   text eol=lf working-tree-encoding=UTF-8
*.md     text eol=lf working-tree-encoding=UTF-8
*.j2     text eol=lf working-tree-encoding=UTF-8
*.css    text eol=lf working-tree-encoding=UTF-8
*.py     text eol=lf working-tree-encoding=UTF-8

*.pdf    binary
*.png    binary
*.jpg    binary
*.svg    text eol=lf
