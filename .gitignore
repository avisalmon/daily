.env
env/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

logs/*
!logs/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
output/digests/*
!output/digests/.gitkeep

# Node / Playwright
node_modules/
package-lock.json
tools/browser/out/

# Never commit anything session-shaped
*browser-profile*
*.cookies
storage-state*.json

# Incoming research source PDFs (inputs, not artifacts).
# The bank index IS committed - it is the record of what we hold.
data/research/*.pdf
data/research/bank/*.pdf

# Transient news cache from the editorial meeting
data/_news_cache.json
