  <polyline class="diagram__curve" id="c14-curve" points=""/>
  <line id="c14-limit" x1="100" y1="36" x2="100" y2="170" class="diagram__axis diagram__axis--dashed"/>
  <circle id="c14-marker" cx="470" cy="40" r="5" class="diagram__dot-fill"/>
  <text x="500" y="22" class="diagram__label diagram__label--strong">אחוז שנשאר</text>
  <text x="100" y="192" class="diagram__axis-label">גבול הזיהוי</text>
  <text x="470" y="192" class="diagram__axis-label">0</text>
  </svg>
  </div>

  <div class="sim__readout sim__readout--three">
  <div class="sim__stat sim__stat--strong">
  <span class="sim__stat-label">פחמן 14 שנשאר</span>
  <span class="sim__stat-value ltr" id="c14-out-frac"></span>
  </div>
  <div class="sim__stat">
  <span class="sim__stat-label">מחציות חיים שחלפו</span>
  <span class="sim__stat-value ltr" id="c14-out-halves"></span>
  </div>
  <div class="sim__stat">
  <span class="sim__stat-label">שינוי ביחס על כל מאה שנה</span>
  <span class="sim__stat-value ltr" id="c14-out-slope"></span>
  </div>
  </div>

  <p class="sim__note" id="c14-note"></p>
  <p class="sim__note euv-caveat">{{ topic.sim.caveat }}</p>
  </section>
  {% endif %}

  {% if topic.quiz %}
  <section class="quiz" id="quiz">
    <h2 class="topic__heading">בדקו את עצמכם</h2>
    <form id="quiz-form">
      {% for q in topic.quiz %}
      {% set qi = loop.index0 %}
      <fieldset class="quiz__q" data-answer="{{ q.answer }}">
        <legend class="quiz__legend"><span class="quiz__num">{{ loop.index }}</span>{{ q.q }}</legend>
        {% for opt in q.options %}
        <label class="quiz__opt">
          <input type="radio" name="q{{ qi }}" value="{{ loop.index0 }}">
          <span>{{ opt }}</span>
        </label>
        {% endfor %}
        <p class="quiz__why">{{ q.why }}</p>
      </fieldset>
      {% endfor %}
      <div class="quiz__actions">
        <button type="button" id="quiz-check" class="quiz__btn">בדקו את התשובות</button>
        <button type="button" id="quiz-reset" class="quiz__btn quiz__btn--ghost">נקו</button>
        <p class="quiz__score" id="quiz-score" role="status"></p>
      </div>
    </form>
  </section>
  {% endif %}

  {% if topic.takeaways %}
  <section class="takeaways">
    <h2 class="topic__heading">מה חשוב לזכור</h2>
    <ul class="takeaways__list">
      {% for t in topic.takeaways %}
      <li>{{ t }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</article>

<script>
/* ===== שעון: רגישות לשדה מגנטי ===== */
(function () {
  var stage = document.getElementById('ck-stage');
  if (!stage) return;

  var RATIO = 1836;
  var inField = document.getElementById('ck-in-field');
  var outField = document.getElementById('ck-out-field');
  var outE = document.getElementById('ck-out-e');
  var outN = document.getElementById('ck-out-n');
  var barE = document.getElementById('ck-bar-e');
  var barN = document.getElementById('ck-bar-n');
  var note = document.getElementById('ck-note');

  function fmt(hz) {
    if (hz >= 1000) return (hz / 1000).toFixed(1) + ' קילו-הרץ';
    if (hz >= 1) return hz.toFixed(1) + ' הרץ';
    if (hz >= 0.001) return (hz * 1000).toFixed(1) + ' מילי-הרץ';
    return (hz * 1e6).toFixed(1) + ' מיקרו-הרץ';
  }

  function render() {
    var mG = Number(inField.value);
    var shiftE = 1.4e6 * (mG / 1000);
    var shiftN = shiftE / RATIO;
    var frac = mG / 100;

    outField.textContent = mG + ' mG';
    outE.textContent = fmt(shiftE);
    outN.textContent = fmt(shiftN);

    var hE = Math.round(120 * frac);
    var hN = Math.round(120 * frac);
    barE.setAttribute('height', hE);
    barE.setAttribute('y', 150 - hE);
    barN.setAttribute('height', hN);
    barN.setAttribute('y', 150 - hN);

    if (mG === 0) {
      note.textContent = 'בלי שדה חיצוני שני המעברים יושבים בדיוק על התדר שלהם. זה המצב שכל שעון מנסה להתקרב אליו, ולשם הולך רוב המאמץ ההנדסי.';
    } else {
      note.textContent = 'שתי העמודות נראות שוות גובה רק מפני שהעמודה הגרעינית מצוירת בהגדלה של פי 1,836. בסקאלה אמיתית היא הייתה דקה מקו.';
    }
  }

  inField.addEventListener('input', render);
  render();
})();
</script>

<script>
/* ===== פחמן 14: גיל, יחס, וגבול הזיהוי ===== */
(function () {
  var stage = document.getElementById('c14-stage');
  if (!stage) return;

  var HALF = 5730;
  var MAXT = 60000;
  var LIMIT = 51570;
  var X0 = 470, X1 = 40, Y0 = 40, Y1 = 170;

  var inAge = document.getElementById('c14-in-age');
  var outAge = document.getElementById('c14-out-age');
  var outFrac = document.getElementById('c14-out-frac');
  var outHalves = document.getElementById('c14-out-halves');
  var outSlope = document.getElementById('c14-out-slope');
  var curve = document.getElementById('c14-curve');
  var marker = document.getElementById('c14-marker');
  var limit = document.getElementById('c14-limit');
  var note = document.getElementById('c14-note');

  function frac(t) { return Math.pow(0.5, t / HALF); }
  function px(t) { return X0 - (X0 - X1) * (t / MAXT); }
  function py(f) { return Y1 - (Y1 - Y0) * f; }

  var pts = [];
  for (var i = 0; i <= 120; i++) {
    var t = (i / 120) * MAXT;
    pts.push(px(t).toFixed(1) + ',' + py(frac(t)).toFixed(1));
  }
  curve.setAttribute('points', pts.join(' '));
  limit.setAttribute('x1', px(LIMIT).toFixed(1));
  limit.setAttribute('x2', px(LIMIT).toFixed(1));

  function render() {
    var t = Number(inAge.value);
    var f = frac(t);
    var drop = (f - frac(t + 100)) * 100;

    outAge.textContent = t.toLocaleString('en-US') + ' שנה';
    outFrac.textContent = (f * 100).toFixed(2) + '%';
    outHalves.textContent = (t / HALF).toFixed(2);
    outSlope.textContent = drop.toFixed(3) + ' נקודות אחוז';
    marker.setAttribute('cx', px(t).toFixed(1));
    marker.setAttribute('cy', py(f).toFixed(1));

    if (t > LIMIT) {
      note.textContent = 'מעבר לגבול. נשאר פחות מ-0.2 אחוזים, וזיהום זעיר בפחמן מודרני כבר גדול מהאות עצמו. בטווח הזה המדידה אינה אומרת כמה הדגימה ישנה, רק שהיא ישנה מדי.';
    } else if (drop < 0.2) {
      note.textContent = 'מאה שנות הפרש אמיתי כבר כמעט אינן נראות במדידה. זו הסיבה שטווח השגיאה שמדווח לצד התאריך גדל עם הגיל, הרבה לפני שהשיטה נעצרת.';
    } else {
      note.textContent = 'בטווח הזה מאה שנות הפרש עדיין מזיזות את היחס מספיק כדי למדוד אותן. זה הטווח שבו תיארוך רדיופחמני מדויק יחסית, והוא מכסה את רוב הארכיאולוגיה ההיסטורית.';
    }
  }

  inAge.addEventListener('input', render);
  render();
})();
</script>

<script>
/* ===== סימן מים: ההתנגשות בין איכות לשרידות ===== */
(function () {
  var stage = document.getElementById('wm-stage');
  if (!stage) return;

  var inStrength = document.getElementById('wm-in-strength');
  var inAttack = document.getElementById('wm-in-attack');
  var outStrength = document.getElementById('wm-out-strength');
  var outAttack = document.getElementById('wm-out-attack');
  var outDetect = document.getElementById('wm-out-detect');
  var outVisible = document.getElementById('wm-out-visible');
  var outAttackName = document.getElementById('wm-out-attack-name');
  var level = document.getElementById('wm-level');
  var noise = document.getElementById('wm-noise');
  var note = document.getElementById('wm-note');

  var ATTACKS = [
    'הקובץ כפי שנוצר',
    'שמירה מחדש באיכות גבוהה',
    'שליחה ברשת חברתית',
    'הקטנה לרוחב חצי',
    'הקטנה ודחיסה חוזרת',
    'חיתוך של שליש מהתמונה',
    'צילום מסך',
    'צילום מסך והעלאה מחדש',
    'צילום מסך, הקטנה ודחיסה',
    'צילום של המסך בטלפון',
    'ציור מחדש של חלק מהתמונה'
  ];

  /* תבנית קבועה, כדי שהרעש לא יקפוץ בכל הזזה של המחוון */
  var SPECKS = [];
  var seed = 7;
  for (var i = 0; i < 90; i++) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    var x = 288 + (seed % 106);
    seed = (seed * 1103515245 + 12345) % 2147483648;
    var y = 22 + (seed % 92);
    SPECKS.push([x, y]);
  }
  for (var j = 0; j < SPECKS.length; j++) {
    var c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    c.setAttribute('cx', SPECKS[j][0]);
    c.setAttribute('cy', SPECKS[j][1]);
    c.setAttribute('r', '1.5');
    noise.appendChild(c);
  }

  function render() {
    var s = parseInt(inStrength.value, 10);
    var a = parseInt(inAttack.value, 10);

    /* מודל ממחיש: הסימן נקרא כשהוא גדול ביחס למה שהעיבוד מחק */
    var ratio = s / (1 + 1.45 * a);
    var detect = 100 * (ratio * ratio) / (ratio * ratio + 1);
    detect = Math.max(2, Math.min(99, detect));

    outStrength.textContent = '±' + s + ' רמות';
    outAttack.textContent = ATTACKS[a];
    outDetect.textContent = detect.toFixed(0) + '%';
    outAttackName.textContent = ATTACKS[a];

    outVisible.textContent = s <= 3 ? 'לא' : (s <= 7 ? 'בקושי' : 'כן, הקובץ מתלכלך');

    var h = 96 * detect / 100;
    level.setAttribute('y', 116 - h);
    level.setAttribute('height', h);
    noise.style.opacity = Math.min(0.85, s / 14).toFixed(2);

    if (s <= 3 && detect < 40) {
      note.textContent = 'הטמעה עדינה שורדת קובץ שכמעט לא נגעו בו, ונעלמת ברגע שמישהו שלח אותו הלאה. זה המצב שבו המערכת נראית מצוינת במעבדה וחסרת ערך ברשת.';
    } else if (s >= 9 && detect > 75) {
      note.textContent = 'הסימן עמיד, אבל שימו לב לריבוע הימני. כדי להגיע לכאן שילמתם באיכות, וזה בדיוק מה שמי שמוכר מודל ליצירת תמונות אינו מוכן לשלם.';
    } else if (detect > 75) {
      note.textContent = 'זה אזור העבודה שמערכות אמיתיות מכוונות אליו: סימן שאינו מורגש ושורד את העיבוד השכיח. הוא לא שורד את כל העיבודים.';
    } else if (a >= 9) {
      note.textContent = 'בקצה הזה אין מה לשפר בהטמעה. ציור מחדש של אזור מייצר פיקסלים חדשים שמעולם לא נשאו סימן, וצילום של מסך בטלפון מעביר את התמונה דרך עדשה.';
    } else {
      note.textContent = 'כאן נמצא הגבול. העלאת העוצמה תעזור לזיהוי ותפגע באיכות, והורדתה תעשה את ההפך. אין הגדרה שמנצחת בשני הצירים.';
    }
  }

  inStrength.addEventListener('input', render);
  inAttack.addEventListener('input', render);
  render();
})();
</script>

<script>
/* ===== מדמה המתג הגנטי: אותו רצף, תאים שונים, תוצאה הפוכה ===== */
(function () {
  var stage = document.getElementById('gene-switch-stage');
  if (!stage) return;

  var boxes = Array.prototype.slice.call(document.querySelectorAll('.gene-switch__box'));
  var state = document.getElementById('gs-state');
  var siteState = document.getElementById('gs-site-state');
  var note = document.getElementById('gs-note');
  var site = document.getElementById('gs-site');
  var gene = document.getElementById('gs-gene');
  var myb = document.getElementById('gs-myb');
  var cbp = document.getElementById('gs-cbp');
  var mybLabel = document.getElementById('gs-myb-label');
  var cbpLabel = document.getElementById('gs-cbp-label');

  var ON = 'diagram__dot diagram__dot--strong';
  var OFF = 'diagram__dot';

  function on(key) {
    for (var i = 0; i < boxes.length; i++) {
      if (boxes[i].getAttribute('data-key') === key) return boxes[i].checked;
    }
    return false;
  }

  function render() {
    var mutation = on('mutation'), hasMyb = on('myb'), hasCbp = on('cbp');
    var bound = mutation && hasMyb;
    var enhancer = bound && hasCbp;

    site.setAttribute('class', mutation ? ON : OFF);
    gene.setAttribute('class', enhancer ? ON : OFF);
    myb.style.opacity = hasMyb ? '1' : '0.18';
    mybLabel.style.opacity = hasMyb ? '1' : '0.18';
    cbp.style.opacity = hasCbp ? '1' : '0.18';
    cbpLabel.style.opacity = hasCbp ? '1' : '0.18';
    myb.setAttribute('class', bound ? ON : OFF);
    cbp.setAttribute('class', enhancer ? ON : OFF);

    if (enhancer) {
      state.textContent = 'דלוק ללא הפסקה';
      siteState.textContent = 'אנהנסר חזק';
      note.textContent = 'שלושת התנאים התקיימו. MYB נקשר לאתר שהמוטציה יצרה, CBP סימן את האזור כפעיל, והגן נדלק בלי בקרה. אף חלבון לא השתנה, רק ההוראה מתי לייצר אותו.';
    } else if (bound) {
      state.textContent = 'כבוי';
      siteState.textContent = 'אתר קשירה תפוס, בלי הגברה';
      note.textContent = 'MYB נקשר, אבל בלי CBP האזור אינו מסומן כפעיל ואינו הופך לאנהנסר. אתר קשירה בודד אינו מתג.';
    } else if (mutation && !hasMyb) {
      state.textContent = 'כבוי';
      siteState.textContent = 'אתר קשירה קיים וריק';
      note.textContent = 'זה בדיוק המצב בתא שאינו מייצר MYB. המוטציה נמצאת ברצף, זהה אות באות, ואין מפתח שנכנס למנעול. אותו DNA בדיוק, תוצאה אחרת.';
    } else if (!mutation && hasMyb) {
      state.textContent = 'כבוי';
      siteState.textContent = 'אין אתר קשירה';
      note.textContent = 'MYB נמצא בתא, אבל ברצף התקין אין לו למה להיקשר כאן. גורם שעתוק אינו יכול להפעיל אתר שאינו קיים.';
    } else {
      state.textContent = 'כבוי';
      siteState.textContent = 'רצף תקין, שקט';
      note.textContent = 'זה המצב התקין. האזור הזה לפני הגן אינו מקודד דבר, ובלי המוטציה הוא גם אינו מפעיל דבר.';
    }
  }

  boxes.forEach(function (b) { b.addEventListener('change', render); });
  render();
})();
</script>

<script>
/* ===== מדמה כפל מרוכב: הגדלים מוכפלים והזוויות מתחברות ===== */
(function () {
  var svg = document.getElementById('cx-svg');
  if (!svg) return;

  var CX = 320, CY = 170, SCALE = 26;   // 26 pixels to one unit on both axes
  var AX = 3, AY = 2;                   // the fixed operand, 3 + 2i

  var inMag = document.getElementById('in-mag');
  var inAng = document.getElementById('in-ang');

  var grid = document.getElementById('cx-grid');
  var g = '';
  for (var u = -11; u <= 11; u++) {
    if (u === 0) continue;
    g += '<line x1="' + (CX + u * SCALE) + '" y1="165" x2="' + (CX + u * SCALE) + '" y2="175" class="diagram__axis"/>';
    if (Math.abs(u * SCALE) < 150) {
      g += '<line x1="315" y1="' + (CY - u * SCALE) + '" x2="325" y2="' + (CY - u * SCALE) + '" class="diagram__axis"/>';
    }
  }
  grid.innerHTML = g;

  // One decimal is the honest precision here: the sliders move in steps of
  // 0.05 and 5 degrees, so more digits would be inventing accuracy.
  function fmt(n) {
    var v = Math.round(n * 100) / 100;
    return (v < 0 ? '−' : '') + Math.abs(v).toFixed(2);
  }
  function pair(re, im) {
    return fmt(re) + (im < 0 ? ' − ' : ' + ') + fmt(Math.abs(im)) + 'i';
  }

  function place(el, x, y) { el.setAttribute('x', x); el.setAttribute('y', y); }

  function draw() {
    var m = parseFloat(inMag.value);
    var degs = parseFloat(inAng.value);
    var rad = degs * Math.PI / 180;

    var mre = m * Math.cos(rad), mim = m * Math.sin(rad);
    var pre = AX * mre - AY * mim;
    var pim = AX * mim + AY * mre;

    var aMag = Math.sqrt(AX * AX + AY * AY);
    var aAng = Math.atan2(AY, AX) * 180 / Math.PI;
    var pMag = aMag * m;
    var pAng = aAng + degs;

    document.getElementById('out-mag').textContent = fmt(m);
    document.getElementById('out-ang').textContent = degs + '°';
    document.getElementById('cx-out-mult').textContent = pair(mre, mim);
    document.getElementById('cx-out-prod').textContent = pair(pre, pim);
    document.getElementById('cx-out-mag').textContent = fmt(m) + ' = ' + fmt(pMag);
    document.getElementById('cx-out-ang').textContent = fmt(degs) + '° = ' + fmt(pAng) + '°';

    var ax = CX + AX * SCALE, ay = CY - AY * SCALE;
    var bx = CX + pre * SCALE, by = CY - pim * SCALE;

    document.getElementById('cx-ray-a').setAttribute('x2', ax);
    document.getElementById('cx-ray-a').setAttribute('y2', ay);
    document.getElementById('cx-ray-b').setAttribute('x2', bx);
    document.getElementById('cx-ray-b').setAttribute('y2', by);
    document.getElementById('cx-dot-a').setAttribute('cx', ax);
    document.getElementById('cx-dot-a').setAttribute('cy', ay);
    document.getElementById('cx-dot-b').setAttribute('cx', bx);
    document.getElementById('cx-dot-b').setAttribute('cy', by);

    var la = document.getElementById('cx-lbl-a');
    la.textContent = pair(AX, AY);
    place(la, ax + 26, ay - 8);
    var lb = document.getElementById('cx-lbl-b');
    lb.textContent = pair(pre, pim);
    place(lb, bx + 26, by - 8);

    // The arc runs from the original angle to the product angle at a fixed
    // radius, so it reads as "this much was added", not as a distance.
    var r = 62;
    var a0 = aAng * Math.PI / 180, a1 = pAng * Math.PI / 180;
    var sweep = degs < 0 ? 1 : 0;
    var large = Math.abs(degs) > 180 ? 1 : 0;
    var arc = 'M' + (CX + r * Math.cos(a0)) + ',' + (CY - r * Math.sin(a0)) +
              ' A' + r + ',' + r + ' 0 ' + large + ',' + sweep + ' ' +
              (CX + r * Math.cos(a1)) + ',' + (CY - r * Math.sin(a1));
    document.getElementById('cx-arc').setAttribute('d', Math.abs(degs) < 0.5 ? '' : arc);

    var note = document.getElementById('cx-note');
    if (Math.abs(m - 1) < 0.001 && degs === 90) {
      note.textContent = 'זהו בדיוק כפל ב-i: גודל 1, זווית 90 מעלות. הנקודה הסתובבה רבע סיבוב והמרחק מהראשית לא זז.';
    } else if (Math.abs(m - 1) < 0.001 && Math.abs(degs) === 180) {
      note.textContent = 'גודל 1 וזווית 180 מעלות הם כפל במינוס אחד. שני כפלים ב-i נותנים בדיוק את זה, ומכאן i²=−1.';
    } else if (degs === 0) {
      note.textContent = 'זווית אפס: המכפיל הוא מספר ממשי רגיל, והוא רק מותח או מכווץ לאורך אותו ישר.';
    } else if (Math.abs(m - 1) < 0.001) {
      note.textContent = 'גודל 1 פירושו סיבוב טהור. המרחק מהראשית נשמר, רק הזווית זזה.';
    } else {
      note.textContent = 'שתי הפעולות קורות יחד: הגודל מוכפל ב-' + fmt(m) + ' והזווית זזה ב-' + degs + ' מעלות.';
    }
  }

  inMag.addEventListener('input', draw);
  inAng.addEventListener('input', draw);
  draw();
}());
</script>

<script>
/* ===== מדמה חיפוש מטרה של CRISPR ===== */
(function () {
  var host = document.getElementById('crispr-genome');
  if (!host) return;

  var genome = host.getAttribute('data-genome') || '';
  var guide = host.getAttribute('data-guide') || '';
  var G = guide.length;
  var slider = document.getElementById('in-mm');
  var out = document.getElementById('out-mm');
  var rows = document.getElementById('crispr-hits');
  var note = document.getElementById('crispr-note');

  // A site is worth showing if the protein could plausibly reach it: either a
  // near match with a PAM, or a perfect match without one. The second case is
  // the whole point of the exercise, so it is never filtered out.
  var sites = [];
  for (var i = 0; i + G + 3 <= genome.length; i++) {
    var seq = genome.substr(i, G);
    var pam = genome.substr(i + G, 3);
    var hasPam = pam.charAt(1) === 'G' && pam.charAt(2) === 'G';
    var mm = 0, near = null;
    for (var j = 0; j < G; j++) {
      if (seq.charAt(j) !== guide.charAt(j)) {
        mm++;
        near = G - j;
      }
    }
    if ((hasPam && mm <= 4) || mm === 0) {
      sites.push({ at: i, seq: seq, pam: pam, hasPam: hasPam, mm: mm, near: near });
    }
  }
  sites.sort(function (a, b) { return a.mm - b.mm || a.at - b.at; });

  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

  // The count of mismatches is not the whole rule. The stretch of about ten
  // letters next to the PAM is checked first, and a mismatch there usually stops
  // the protein, while the same mismatch at the far end is often tolerated. A
  // simulator that only counted mismatches would contradict the section above it.
  var SEED = 10;
  function cuts(s, tol) {
    return s.hasPam && s.mm <= tol && (s.mm === 0 || s.near > SEED);
  }

  function draw() {
    var tol = parseInt(slider.value, 10);
    var cut = sites.filter(function (s) { return cuts(s, tol); });
    var cutAt = {};
    cut.forEach(function (s) { cutAt[s.at] = true; });

    var html = '', pos = 0;
    sites.slice().sort(function (a, b) { return a.at - b.at; }).forEach(function (s) {
      if (s.at < pos) return;
      html += esc(genome.slice(pos, s.at));
      var cls = cutAt[s.at] ? 'crispr-site crispr-site--cut'
              : (s.hasPam ? 'crispr-site' : 'crispr-site crispr-site--nopam');
      html += '<span class="' + cls + '">' + esc(s.seq) + '</span>';
      html += '<span class="crispr-pam-mark' + (s.hasPam ? '' : ' crispr-pam-mark--absent') + '">'
           + esc(s.pam) + '</span>';
      pos = s.at + G + 3;
    });
    html += esc(genome.slice(pos));
    host.innerHTML = html;

    out.textContent = tol;
    rows.innerHTML = sites.map(function (s) {
      var willCut = cuts(s, tol);
      var verdict = !s.hasPam ? 'אין PAM, אין חיתוך'
                  : (willCut ? (s.mm === 0 ? 'האתר המבוקש' : 'חיתוך לא מכוון')
                    : (s.mm <= tol ? 'אי־ההתאמה צמודה ל-PAM. נעצר' : 'יותר מדי אי־התאמות'));
      return '<tr class="' + (willCut ? 'is-cut' : '') + '">'
        + '<td class="ltr">' + s.at + '</td>'
        + '<td class="ltr">' + s.mm + '</td>'
        + '<td class="ltr">' + (s.near === null ? '' : s.near) + '</td>'
        + '<td class="ltr">' + esc(s.pam) + '</td>'
        + '<td>' + verdict + '</td>'
        + '</tr>';
    }).join('');

    var extra = cut.length - 1;
    if (tol === 0) {
      note.textContent = 'בסובלנות אפס נחתך אתר אחד בלבד. שימו לב לאתר השני ברשימה: '
        + 'הוא מתאים למדריך בכל עשרים האותיות, ובכל זאת אינו נחתך, כי אחריו אין PAM.';
    } else if (extra <= 0) {
      note.textContent = 'עדיין אתר אחד. באתר הדומה השני אי־ההתאמות צמודות ל-PAM, ושם החלבון עוצר.';
    } else {
      note.textContent = 'בסובלנות של ' + tol + ' אי־התאמות נחתך אתר נוסף שלא התכוונו אליו. '
        + 'ברצף של 196 אותיות זה נראה מעט. בגנום של שלושה מיליארד אותיות, זה מה שנקרא off-target.';
    }
  }

  slider.addEventListener('input', draw);
  draw();
})();
</script>

<script>
/* ===== מדמה ריבית דריבית ===== */
(function () {
  var svg = document.getElementById('sim-svg');
  if (!svg) return;

  var W = 640, H = 300, PAD = 8;
  var keys = ['principal', 'rate', 'years', 'monthly'];
  var inputs = {}, outs = {};
  keys.forEach(function (k) {
    inputs[k] = document.getElementById('in-' + k);
    outs[k] = document.getElementById('out-' + k);
  });
  if (!inputs.principal) return;

  var fmt = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });

  function series(P, r, years, monthly) {
    var simple = [], compound = [], paid = [];
    var comp = P, totalPaid = P;
    for (var t = 0; t <= years; t++) {
      if (t > 0) {
        comp = comp * (1 + r);
        // הפקדות חודשיות נצברות במהלך השנה וגם הן צוברות ריבית
        for (var m = 0; m < 12; m++) comp += monthly * Math.pow(1 + r, (12 - m - 1) / 12);
        totalPaid += monthly * 12;
      }
      simple.push(P * (1 + r * t) + monthly * 12 * t);
      compound.push(comp);
      paid.push(totalPaid);
    }
    return { simple: simple, compound: compound, paid: paid };
  }

  function points(arr, max, years) {
    var n = arr.length - 1;
    return arr.map(function (v, i) {
      var x = PAD + (i / Math.max(n, 1)) * (W - PAD * 2);
      var y = H - PAD - (v / max) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
  }

  function render() {
    var P = +inputs.principal.value;
    var rPct = +inputs.rate.value;
    var years = +inputs.years.value;
    var monthly = +inputs.monthly.value;
    var r = rPct / 100;

    outs.principal.textContent = fmt.format(P) + ' ₪';
    outs.rate.textContent = rPct + '%';
    outs.years.textContent = years + ' שנים';
    outs.monthly.textContent = monthly ? fmt.format(monthly) + ' ₪' : 'ללא';

    var s = series(P, r, years, monthly);
    var max = Math.max(s.compound[years], s.simple[years]) * 1.05 || 1;

    document.getElementById('sim-simple').setAttribute('points', points(s.simple, max, years));
    document.getElementById('sim-compound').setAttribute('points', points(s.compound, max, years));

    var fin = s.compound[years], sim = s.simple[years];
    document.getElementById('sim-out-simple').textContent = fmt.format(Math.round(sim)) + ' ₪';
    document.getElementById('sim-out-compound').textContent = fmt.format(Math.round(fin)) + ' ₪';
    document.getElementById('sim-out-gap').textContent = fmt.format(Math.round(fin - sim)) + ' ₪';
    document.getElementById('sim-out-paid').textContent = fmt.format(Math.round(s.paid[years])) + ' ₪';
    document.getElementById('sim-years-axis').textContent = '0 – ' + years;

    var note = document.getElementById('sim-note');
    var times = s.paid[years] ? fin / s.paid[years] : 0;
    var rule72 = rPct > 0 ? (72 / rPct) : 0;
    note.textContent = 'בריבית של ' + rPct + '% הכסף מכפיל את עצמו בערך כל '
      + rule72.toFixed(1) + ' שנים (כלל 72). אחרי ' + years + ' שנים היתרה גדולה פי '
      + times.toFixed(1) + ' מסך מה שהפקדתם.';
  }

  keys.forEach(function (k) { inputs[k].addEventListener('input', render); });
  render();
})();

/* ===== מדמה ההתכנסות אל e ===== */
(function () {
  var svg = document.getElementById('e-svg');
  if (!svg) return;

  var W = 640, H = 300, PAD = 8;
  var E = Math.E, STEPS = 13;
  var inN = document.getElementById('in-nexp');
  var inT = document.getElementById('in-terms');
  if (!inN || !inT) return;

  function limitAt(n) { return Math.pow(1 + 1 / n, n); }

  function seriesAt(terms) {
    var s = 0, f = 1;
    for (var k = 0; k < terms; k++) {
      if (k > 0) f *= k;
      s += 1 / f;
    }
    return s;
  }

  /* שתי העקומות מצוירות על אותו ציר צעדים כדי שההשוואה תהיה הוגנת: צעד אחד
     בגבול הוא חלוקה נוספת, צעד אחד בטור הוא מחובר נוסף. תחתית הגרף היא 1.8
     ולא אפס, אחרת כל ההבדל המעניין נדחס לפס דק. */
  function points(fn) {
    var lo = 1.8, hi = E + (E - lo) * 0.08;
    var out = [];
    for (var i = 1; i <= STEPS; i++) {
      var v = Math.min(fn(i), hi);
      var x = PAD + ((i - 1) / (STEPS - 1)) * (W - PAD * 2);
      var y = H - PAD - ((v - lo) / (hi - lo)) * (H - PAD * 2);
      out.push(x.toFixed(1) + ',' + Math.min(Math.max(y, PAD), H - PAD).toFixed(1));
    }
    return out.join(' ');
  }

  document.getElementById('e-limit').setAttribute('points', points(limitAt));
  document.getElementById('e-series').setAttribute('points', points(seriesAt));

  var fmtInt = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });

  function render() {
    var n = Math.pow(10, +inN.value);
    var terms = +inT.value;
    var lim = limitAt(n), ser = seriesAt(terms);

    document.getElementById('out-nexp').textContent = 'n = ' + fmtInt.format(n);
    document.getElementById('out-terms').textContent = terms;
    document.getElementById('e-out-limit').textContent = lim.toFixed(10);
    document.getElementById('e-out-series').textContent = ser.toFixed(10);
    document.getElementById('e-out-cost').textContent =
      fmtInt.format(n) + ' מול ' + terms;

    /* ספרות נכונות אחרי הנקודה, לפי גודל השגיאה */
    function digits(v) {
      var err = Math.abs(v - E);
      return err === 0 ? 12 : Math.max(0, Math.floor(-Math.log10(err)));
    }
    document.getElementById('e-note').textContent =
      'ספרות נכונות אחרי הנקודה: הגבול עם ' + fmtInt.format(n) + ' חלוקות, '
      + digits(lim) + '. הטור עם ' + terms + ' מחוברים, ' + digits(ser) + '.';
  }

  inN.addEventListener('input', render);
  inT.addEventListener('input', render);
  render();
})();

/* ===== בוחן ===== */
(function () {
  var form = document.getElementById('quiz-form');
  if (!form) return;
  var qs = Array.prototype.slice.call(form.querySelectorAll('.quiz__q'));
  var scoreEl = document.getElementById('quiz-score');

  document.getElementById('quiz-check').addEventListener('click', function () {
    var right = 0, answered = 0;
    qs.forEach(function (q) {
      var correct = +q.dataset.answer;
      var picked = q.querySelector('input:checked');
      q.classList.remove('is-right', 'is-wrong');
      if (!picked) return;
      answered++;
      if (+picked.value === correct) { q.classList.add('is-right'); right++; }
      else { q.classList.add('is-wrong'); }
      q.querySelectorAll('.quiz__opt').forEach(function (opt, i) {
        opt.classList.toggle('is-answer', i === correct);
      });
    });
    if (!answered) { scoreEl.textContent = 'בחרו תשובה לפחות בשאלה אחת.'; return; }
    scoreEl.textContent = 'ענית נכון על ' + right + ' מתוך ' + qs.length + '.';
  });

  document.getElementById('quiz-reset').addEventListener('click', function () {
    form.reset();
    qs.forEach(function (q) {
      q.classList.remove('is-right', 'is-wrong');
      q.querySelectorAll('.quiz__opt').forEach(function (o) { o.classList.remove('is-answer'); });
    });
    scoreEl.textContent = '';
  });
})();

/* ===== מדמה רזולוציה ליתוגרפית: CD = k1 · λ / NA ===== */
(function () {
  var svg = document.getElementById('euv-svg');
  if (!svg) return;

  var naIn = document.getElementById('in-na');
  var k1In = document.getElementById('in-k1');
  var naOut = document.getElementById('out-na');
  var k1Out = document.getElementById('out-k1');
  var linesG = document.getElementById('euv-lines');
  var blurNode = document.getElementById('euv-blur-node');
  var btns = Array.prototype.slice.call(document.querySelectorAll('.euv-source-btn'));
  if (!naIn || !btns.length) return;

  var W = 640, H = 190;
  var lambda = +btns[0].dataset.lambda;
  var naMax = +btns[0].dataset.namax;

  function cd(lam, na, k1) { return k1 * lam / na; }

  function draw() {
    var na = Math.min(+naIn.value, naMax);
    var k1 = +k1In.value;
    var res = cd(lambda, na, k1);

    naOut.textContent = na.toFixed(2);
    k1Out.textContent = k1.toFixed(2);

    // רוחב הקו על המסך פרופורציוני לרוחב האמיתי, בסקאלה קבועה
    var nmPerPx = 0.9;                       // 640 פיקסלים = 576 ננומטר
    var wpx = Math.max(1.2, res / nmPerPx);
    var pitch = wpx * 2;
    var n = Math.ceil(W / pitch) + 1;

    var out = '';
    for (var i = 0; i < n; i++) {
      out += '<rect x="' + (i * pitch).toFixed(2) + '" y="18" width="' +
             wpx.toFixed(2) + '" height="' + (H - 36) + '" class="euv-line"/>';
    }
    linesG.innerHTML = out;

    // ככל שהקו מתקרב לגבול הפיזיקלי הוא נמרח. k1 נמוך = תהליך אגרסיבי = פחות חד.
    // הטשטוש נחסם, אחרת קווים רחבים נראים מרוחים הרבה מעבר למה שהכוונה להמחיש
    var sharp = Math.max(0, Math.min(1, (k1 - 0.25) / 0.20));
    blurNode.setAttribute('stdDeviation',
      Math.min(wpx * (1 - sharp) * 0.28, 4.5).toFixed(2));

    document.getElementById('euv-out-cd').textContent = res.toFixed(1) + ' nm';
    document.getElementById('euv-out-lambda').textContent = lambda + ' nm';
    document.getElementById('euv-scale').textContent =
      'רוחב התמונה כאן הוא כ-' + Math.round(W * nmPerPx) + ' ננומטר';

    // ההשוואה ל-DUV נעשית בתנאים הטובים ביותר שיש לו: טבילה במים, NA 1.35
    var duv = cd(193, 1.35, k1);
    document.getElementById('euv-out-duv').textContent = duv.toFixed(1) + ' nm';

    // כל מעבר הדפסה נוסף חוצה בקירוב את הצפיפות
    var passes = duv <= res ? 1 : Math.pow(2, Math.ceil(Math.log(duv / res) / Math.log(2)));
    document.getElementById('euv-out-passes').textContent =
      lambda === 193 ? 'לא חל' : '×' + passes;

    var note = document.getElementById('euv-note');
    if (lambda === 193) {
      note.textContent = 'ב-193 ננומטר צריך צמצם גדול מ-1, וזה אפשרי רק כשממלאים ' +
        'את המרווח שבין העדשה לפרוסה במים. זה מה שנקרא ליתוגרפיית טבילה.';
    } else {
      note.textContent = 'קיצור אורך הגל פי כ-14 קונה את אותה רזולוציה בלי צמצם ענק ' +
        'ובלי לחזור על ההדפסה. זו כל התכלית של EUV.';
    }
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      btns.forEach(function (o) { o.classList.remove('is-active'); });
      b.classList.add('is-active');
      lambda = +b.dataset.lambda;
      naMax = +b.dataset.namax;
      naIn.max = naMax;
      // כל מקור אור מגיע עם הצמצם האופייני לו, אחרת ההשוואה חסרת משמעות
      naIn.value = b.dataset.natypical;
      draw();
    });
  });
  [naIn, k1In].forEach(function (el) { el.addEventListener('input', draw); });
  naIn.max = naMax;
  draw();
})();

/* ===== מדמה האופטוגנטיקה: גן, אור, ואורך הגל הנכון ===== */
(function () {
  var stage = document.getElementById('opto-switch-stage');
  if (!stage) return;

  var boxes = Array.prototype.slice.call(document.querySelectorAll('.opto-switch__box'));
  var state = document.getElementById('op-state');
  var chanState = document.getElementById('op-channel-state');
  var note = document.getElementById('op-note');
  var channel = document.getElementById('op-channel');
  var beam = document.getElementById('op-beam');
  var lamp = document.getElementById('op-lamp');
  var ions = ['op-ion1', 'op-ion2', 'op-ion3'].map(function (id) {
    return document.getElementById(id);
  });

  var ON = 'diagram__dot diagram__dot--strong';
  var OFF = 'diagram__dot';

  function on(key) {
    for (var i = 0; i < boxes.length; i++) {
      if (boxes[i].getAttribute('data-key') === key) return boxes[i].checked;
    }
    return false;
  }

  function render() {
    var gene = on('gene'), light = on('light'), blue = on('blue');
    var lit = light && blue;
    var open = gene && lit;

    lamp.setAttribute('class', light ? ON : OFF);
    beam.style.opacity = light ? '1' : '0.15';
    channel.style.opacity = gene ? '1' : '0.15';
    channel.setAttribute('class', open ? ON : OFF);
    ions.forEach(function (c) {
      c.setAttribute('class', open ? ON : OFF);
      c.style.opacity = open ? '1' : '0.3';
    });

    if (open) {
      state.textContent = 'יורה';
      chanState.textContent = 'פתוחה';
      note.textContent = 'שלושת התנאים התקיימו. האור הכחול פתח את התעלה, יונים טעונים ' +
        'נכנסו, והנוירון ירה. שימו לב שהתא השכן מואר באותו אור בדיוק ואינו מגיב, ' +
        'כי אין לו את החלבון. ההפרדה הזו היא כל העניין.';
    } else if (gene && light && !blue) {
      state.textContent = 'שקט';
      chanState.textContent = 'סגורה';
      note.textContent = 'החלבון נמצא בתא והאור דולק, אבל אורך הגל לא מתאים. ' +
        'כלמידומונס מגיב לאור כחול, ואור אדום פשוט עובר דרך התעלה בלי לפתוח אותה.';
    } else if (gene && !light) {
      state.textContent = 'שקט';
      chanState.textContent = 'סגורה';
      note.textContent = 'הגן הוחדר והחלבון יושב בקרום, אבל בלי אור הוא אינו עושה דבר. ' +
        'תא שנושא את החלבון בחושך מתנהג כמו כל תא אחר.';
    } else if (!gene && lit) {
      state.textContent = 'שקט';
      chanState.textContent = 'אין תעלה בקרום';
      note.textContent = 'זו הביקורת החשובה בניסוי. אור כחול על תא רגיל אינו מדליק אותו. ' +
        'אם התא היה יורה כאן, הממצא כולו היה מתפרק.';
    } else {
      state.textContent = 'שקט';
      chanState.textContent = 'אין תעלה בקרום';
      note.textContent = 'מצב ההתחלה. הדליקו תנאים ובדקו מה נדרש כדי שהנוירון יירה.';
    }
  }

  boxes.forEach(function (b) { b.addEventListener('change', render); });
  render();
})();
</script>
{% endblock %}
