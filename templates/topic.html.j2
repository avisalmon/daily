{% extends "_shell.html.j2" %}

{% block page_title %}{{ topic.title }}{% endblock %}
{% block section_label %}לומדים היום{% endblock %}

{% block content %}
<article class="topic">

  <header class="topic__head">
    <p class="topic__level">{{ topic.level }}{% if topic.reading_minutes %} · קריאה של {{ topic.reading_minutes }} דקות{% endif %}</p>
    <h1 class="topic__title">{{ topic.title }}</h1>
    {% if topic.subtitle %}<p class="topic__subtitle">{{ topic.subtitle }}</p>{% endif %}
    <p class="topic__summary">{{ topic.summary }}</p>
    {% if topic.edition %}
    <p class="topic__origin">
      פורסם לראשונה במהדורת <a href="{{ base }}editions/{{ topic.edition }}.html">{{ topic.date_long | default(topic.edition) }}</a>
    </p>
    {% endif %}
  </header>

  {% for sec in topic.sections %}
  <section class="topic__section">
    <h2 class="topic__heading">{{ sec.heading }}</h2>
    {% for p in sec.paras %}
    <p>{{ p }}</p>
    {% endfor %}

    {% if sec.formula %}
    <div class="formula">
      <p class="formula__label">{{ sec.formula.label }}</p>
      {% for line in sec.formula.lines %}
      <p class="formula__line">
        <span class="formula__name">{{ line.name }}</span>
        <span class="formula__expr ltr">{{ line.expr }}</span>
      </p>
      {% endfor %}
      <p class="formula__legend">{{ sec.formula.legend }}</p>
    </div>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'linear-vs-exponential' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="השוואה בין גדילה לינארית לגדילה מעריכית" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <polyline class="diagram__linear" points="52,220 500,150"/>
        <path class="diagram__exp" d="M52,220 C210,214 330,190 420,120 S488,44 500,26"/>
        <circle cx="500" cy="150" r="4" class="diagram__dot"/>
        <circle cx="500" cy="26" r="4" class="diagram__dot diagram__dot--strong"/>
        <text x="492" y="168" class="diagram__label">ריבית פשוטה</text>
        <text x="492" y="18" class="diagram__label diagram__label--strong">ריבית דריבית</text>
        <text x="276" y="248" class="diagram__axis-label">זמן ←</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'e-limit-steps' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="ערך הסכום כשמחלקים את השנה למספר גדל של תקופות ריבית, מתקרב ל-e ולא עובר אותו" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <line x1="52" y1="44" x2="500" y2="44" class="diagram__linear"/>
        <text x="496" y="36" class="diagram__label diagram__label--strong">e = 2.71828</text>
        <rect x="74"  y="164" width="40" height="56"  class="diagram__dot"/>
        <rect x="150" y="128" width="40" height="92"  class="diagram__dot"/>
        <rect x="226" y="72"  width="40" height="148" class="diagram__dot"/>
        <rect x="302" y="49"  width="40" height="171" class="diagram__dot"/>
        <rect x="378" y="45"  width="40" height="175" class="diagram__dot diagram__dot--strong"/>
        <text x="94"  y="238" class="diagram__axis-label">1</text>
        <text x="170" y="238" class="diagram__axis-label">2</text>
        <text x="246" y="238" class="diagram__axis-label">12</text>
        <text x="322" y="238" class="diagram__axis-label">365</text>
        <text x="398" y="238" class="diagram__axis-label">8760</text>
        <text x="94"  y="156" class="diagram__label">2.00</text>
        <text x="170" y="120" class="diagram__label">2.25</text>
        <text x="246" y="64"  class="diagram__label">2.613</text>
        <text x="322" y="41"  class="diagram__label">2.7146</text>
        <text x="276" y="256" class="diagram__axis-label">מספר חלוקות בשנה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'e-derivative' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="הפונקציה e בחזקת x, ומשיק שהשיפוע שלו שווה לגובה הפונקציה באותה נקודה" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <path class="diagram__exp" d="M52,214 C160,210 250,196 330,164 S440,74 480,26"/>
        <line x1="286" y1="220" x2="286" y2="182" class="diagram__linear"/>
        <line x1="212" y1="220" x2="360" y2="144" class="diagram__linear"/>
        <circle cx="286" cy="182" r="4" class="diagram__dot diagram__dot--strong"/>
        <text x="300" y="176" class="diagram__label diagram__label--strong">גובה = שיפוע</text>
        <text x="470" y="20"  class="diagram__label">y = e^x</text>
        <text x="276" y="248" class="diagram__axis-label">x ←</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-wavelength' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="השוואה בסקאלה בין אורכי גל של אור נראה, DUV ו-EUV, ובין גודל הפרט שמדפיסים" preserveAspectRatio="xMidYMid meet">
        <text x="520" y="30" class="diagram__label diagram__label--strong">אור נראה · כ-550 ננומטר</text>
        <rect x="80" y="38" width="440" height="14" class="euv-bar euv-bar--faint"/>
        <text x="520" y="80" class="diagram__label diagram__label--strong">DUV · 193 ננומטר</text>
        <rect x="366" y="88" width="154" height="14" class="euv-bar"/>
        <text x="520" y="130" class="diagram__label diagram__label--strong">EUV · 13.5 ננומטר</text>
        <rect x="509" y="138" width="11" height="14" class="euv-bar euv-bar--strong"/>
        <text x="520" y="180" class="diagram__label">הפרט שרוצים להדפיס · כ-20 ננומטר</text>
        <rect x="504" y="188" width="16" height="14" class="euv-bar euv-bar--feature"/>
        <line x1="80" y1="216" x2="520" y2="216" class="diagram__axis"/>
        <text x="300" y="238" class="diagram__axis-label">הכול באותה סקאלה. הפרט קטן מאורך הגל של DUV פי כמעט עשרה, וזה כל הקושי</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-source' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 260" role="img" aria-label="שלושת שלבי יצירת האור: טיפת בדיל, פולס משטח, ופולס שני שמאייד אותה לפלזמה קורנת" preserveAspectRatio="xMidYMid meet">
        <text x="548" y="40" class="diagram__label diagram__label--strong">1 · טיפת בדיל נופלת</text>
        <line x1="300" y1="10" x2="300" y2="22" class="euv-arrow"/>
        <circle cx="300" cy="36" r="9" class="euv-drop"/>

        <text x="548" y="116" class="diagram__label diagram__label--strong">2 · פולס לייזר משטח אותה</text>
        <ellipse cx="300" cy="112" rx="18" ry="5" class="euv-drop"/>
        <line x1="180" y1="112" x2="272" y2="112" class="euv-laser"/>
        <text x="170" y="108" class="diagram__label">לייזר</text>

        <text x="548" y="182" class="diagram__label diagram__label--strong">3 · פולס שני מאייד אותה לפלזמה</text>
        <text x="548" y="202" class="diagram__label">קרינה ב-13.5 ננומטר לכל הכיוונים</text>
        <line x1="170" y1="186" x2="264" y2="186" class="euv-laser euv-laser--strong"/>
        <circle cx="300" cy="186" r="27" class="euv-plasma euv-plasma--outer"/>
        <circle cx="300" cy="186" r="16" class="euv-plasma"/>
        <circle cx="300" cy="186" r="6" class="euv-plasma-core"/>
        <line x1="332" y1="186" x2="346" y2="186" class="euv-beam euv-beam--faint"/>
        <line x1="322.6" y1="163.4" x2="332.5" y2="153.5" class="euv-beam euv-beam--faint"/>
        <line x1="300" y1="154" x2="300" y2="140" class="euv-beam euv-beam--faint"/>
        <line x1="277.4" y1="163.4" x2="267.5" y2="153.5" class="euv-beam euv-beam--faint"/>
        <line x1="277.4" y1="208.6" x2="267.5" y2="218.5" class="euv-beam euv-beam--faint"/>
        <line x1="300" y1="218" x2="300" y2="232" class="euv-beam euv-beam--faint"/>
        <line x1="322.6" y1="208.6" x2="332.5" y2="218.5" class="euv-beam euv-beam--faint"/>
        <text x="300" y="252" class="diagram__axis-label">עשרות אלפי טיפות בשנייה. את הקרינה אוספת מראה קעורה ושולחת אותה אל המסכה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-mirror' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="מראת ברג רב-שכבתית: שכבות מוליבדן וסיליקון, שכל ממשק ביניהן מחזיר שבריר מהאור" preserveAspectRatio="xMidYMid meet">
        {% for i in range(9) %}
        <rect x="90" y="{{ 66 + i * 18 }}" width="300" height="9" class="euv-layer euv-layer--mo"/>
        <rect x="90" y="{{ 75 + i * 18 }}" width="300" height="9" class="euv-layer euv-layer--si"/>
        {% endfor %}

        <rect x="500" y="64" width="14" height="10" class="euv-layer euv-layer--mo"/>
        <text x="494" y="73" class="diagram__label">מוליבדן</text>
        <rect x="500" y="84" width="14" height="10" class="euv-layer euv-layer--si"/>
        <text x="494" y="93" class="diagram__label">סיליקון</text>

        <text x="548" y="18" class="diagram__label diagram__label--strong">אור נכנס</text>
        <line x1="470" y1="20" x2="330" y2="66" class="euv-beam"/>
        {% for i in range(5) %}
        <line x1="{{ 330 - i * 6 }}" y1="{{ 66 + i * 36 }}" x2="{{ 415.5 - i * 6 }}" y2="{{ 38 + i * 36 }}" class="euv-beam euv-beam--faint"/>
        {% endfor %}
        <text x="300" y="244" class="diagram__axis-label">עשרות זוגות שכבות בעובי ננומטרים. כל ממשק מחזיר מעט, וההחזרות מתחברות בפאזה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}
    {% if sec.diagram and sec.diagram.type == 'crispr-parts' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="מדריך RNA נצמד לרצף המטרה על גדיל ה-DNA, החלבון אוחז בו, ורצף PAM צמוד מאפשר את החיתוך" preserveAspectRatio="xMidYMid meet">
        <path class="crispr-protein" d="M150,104 L300,88 L450,104 L462,168 L440,214 L300,226 L160,214 L138,168 Z"/>
        <text x="330" y="112" class="diagram__axis-label">Cas9</text>

        <line x1="30" y1="158" x2="530" y2="158" class="crispr-strand"/>
        <line x1="30" y1="190" x2="530" y2="190" class="crispr-strand"/>
        <rect x="180" y="152" width="210" height="12" class="crispr-target"/>
        <rect x="390" y="152" width="31" height="12" class="crispr-pam"/>

        <line x1="180" y1="132" x2="390" y2="132" class="crispr-guide"/>
        {% for i in range(20) %}
        <line x1="{{ 185.25 + i * 10.5 }}" y1="136" x2="{{ 185.25 + i * 10.5 }}" y2="152" class="crispr-pair"/>
        {% endfor %}
        <text x="176" y="128" class="diagram__label diagram__label--strong">מדריך RNA · 20 אותיות</text>

        <line x1="358.5" y1="144" x2="358.5" y2="204" class="crispr-cut"/>
        <text x="352" y="216" class="diagram__label">חיתוך בשני הגדילים</text>

        <text x="405" y="146" class="diagram__axis-label">PAM</text>
        <text x="285" y="180" class="diagram__axis-label">רצף המטרה</text>
        <text x="280" y="243" class="diagram__axis-label">בלי PAM צמוד אין חיתוך</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'crispr-repair' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 260" role="img" aria-label="שבר בשני גדילי הדנא ושני מסלולי התיקון: חיבור מהיר שמשאיר שגיאה, והעתקה מתבנית שכותבת את הרצף הרצוי" preserveAspectRatio="xMidYMid meet">
        <text x="332" y="24" class="diagram__label diagram__label--strong">שבר בשני הגדילים</text>
        <line x1="180" y1="44" x2="268" y2="44" class="crispr-strand"/>
        <line x1="180" y1="58" x2="268" y2="58" class="crispr-strand"/>
        <line x1="292" y1="44" x2="380" y2="44" class="crispr-strand"/>
        <line x1="292" y1="58" x2="380" y2="58" class="crispr-strand"/>

        <line x1="252" y1="76" x2="150" y2="112" class="crispr-arrow"/>
        <line x1="308" y1="76" x2="410" y2="112" class="crispr-arrow"/>

        <text x="268" y="106" class="diagram__label diagram__label--strong">חיבור מהיר</text>
        <line x1="40" y1="150" x2="268" y2="150" class="crispr-strand"/>
        <line x1="40" y1="164" x2="268" y2="164" class="crispr-strand"/>
        <rect x="148" y="144" width="9" height="26" class="crispr-indel"/>
        <text x="268" y="192" class="diagram__label">אות נוספת או חסרה</text>
        <text x="268" y="212" class="diagram__label diagram__label--strong">מסגרת הקריאה זזה. הגן מכובה</text>

        <text x="520" y="106" class="diagram__label diagram__label--strong">העתקה מתבנית</text>
        <line x1="330" y1="126" x2="500" y2="126" class="crispr-template"/>
        <text x="520" y="140" class="diagram__label">תבנית עם הרצף הרצוי</text>
        <line x1="292" y1="164" x2="520" y2="164" class="crispr-strand"/>
        <line x1="292" y1="178" x2="520" y2="178" class="crispr-strand"/>
        <rect x="398" y="158" width="26" height="26" class="crispr-written"/>
        <text x="520" y="212" class="diagram__label diagram__label--strong">הרצף נכתב בדיוק כפי שתוכנן</text>

        <text x="280" y="248" class="diagram__axis-label">המהיר זמין תמיד. המדויק דורש תבנית</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}
  </section>
  {% endfor %}

  {% if topic.sim and topic.sim.type == 'euv-resolution' %}
  <section class="sim" id="sim">
    <h2 class="topic__heading">{{ topic.sim.title }}</h2>
    <p class="sim__intro">{{ topic.sim.intro }}</p>

    <div class="euv-sources" role="group" aria-label="בחירת מקור אור">
      {% for s in topic.sim.sources %}
      <button type="button" class="euv-source-btn{% if loop.first %} is-active{% endif %}"
              data-lambda="{{ s.nm }}" data-namax="{{ s.na_max }}"
              data-natypical="{{ s.na_typical }}">{{ s.label }}</button>
      {% endfor %}
    </div>

    <div class="sim__controls">
      <label class="sim__control">
        <span class="sim__control-head">
          <span>צמצם נומרי (NA)</span>
          <output id="out-na" class="ltr"></output>
        </span>
        <input type="range" id="in-na" min="0.25" max="1.35" step="0.01" value="0.33">
      </label>
      <label class="sim__control">
        <span class="sim__control-head">
          <span>מקדם התהליך (k1)</span>
          <output id="out-k1" class="ltr"></output>
        </span>
        <input type="range" id="in-k1" min="0.25" max="0.6" step="0.01" value="0.35">
      </label>
    </div>

    <div class="euv-stage">
      <svg id="euv-svg" viewBox="0 0 640 190" role="img" aria-label="הדמיה של קווים מודפסים על פרוסת סיליקון">
        <defs>
          <filter id="euv-blur" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur id="euv-blur-node" in="SourceGraphic" stdDeviation="0"/>
          </filter>
        </defs>
        <rect x="0" y="0" width="640" height="190" class="euv-wafer"/>
        <g id="euv-lines" filter="url(#euv-blur)"></g>
      </svg>
      <p class="sim__axis" id="euv-scale"></p>
    </div>

    <div class="sim__readout">
      <div class="sim__stat sim__stat--strong">
        <span class="sim__stat-label">הפרט הקטן ביותר</span>
        <span class="sim__stat-value ltr" id="euv-out-cd"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">אורך גל</span>
        <span class="sim__stat-value ltr" id="euv-out-lambda"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">אותו k1 ב-193 ננומטר בטבילה</span>
        <span class="sim__stat-value ltr" id="euv-out-duv"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">מעברי הדפסה שיידרשו שם</span>
        <span class="sim__stat-value ltr" id="euv-out-passes"></span>
      </div>
    </div>
    <p class="sim__note" id="euv-note"></p>
    <p class="sim__note euv-caveat">{{ topic.sim.caveat }}</p>
  </section>
  {% endif %}

  {% if topic.sim and topic.sim.type == 'compound-interest' %}
  <section class="sim" id="sim">
    <h2 class="topic__heading">{{ topic.sim.title }}</h2>
    <p class="sim__intro">{{ topic.sim.intro }}</p>

    <div class="sim__controls">
      {% for c in topic.sim.controls %}
      <label class="sim__control">
        <span class="sim__control-head">
          <span>{{ c.label }}</span>
          <output id="out-{{ c.key }}" class="ltr"></output>
        </span>
        <input type="range" id="in-{{ c.key }}"
               min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ c.value }}"
               data-unit="{{ c.unit }}">
      </label>
      {% endfor %}
    </div>

    <div class="sim__chart">
      <svg id="sim-svg" viewBox="0 0 640 300" role="img" aria-label="גרף המשווה בין ריבית פשוטה לריבית דריבית" preserveAspectRatio="none">
        <g id="sim-grid"></g>
        <polyline id="sim-simple" class="sim__line sim__line--simple" fill="none"/>
        <polyline id="sim-compound" class="sim__line sim__line--compound" fill="none"/>
      </svg>
      <p class="sim__axis">שנים <span id="sim-years-axis" class="ltr"></span></p>
    </div>

    <div class="sim__readout">
      <div class="sim__stat">
        <span class="sim__stat-label">ריבית פשוטה</span>
        <span class="sim__stat-value ltr" id="sim-out-simple"></span>
      </div>
      <div class="sim__stat sim__stat--strong">
        <span class="sim__stat-label">ריבית דריבית</span>
        <span class="sim__stat-value ltr" id="sim-out-compound"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">ההפרש</span>
        <span class="sim__stat-value ltr" id="sim-out-gap"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">סך ההפקדות</span>
        <span class="sim__stat-value ltr" id="sim-out-paid"></span>
      </div>
    </div>
    <p class="sim__note" id="sim-note"></p>
  </section>
  {% endif %}

  {% if topic.sim and topic.sim.type == 'e-convergence' %}
  <section class="sim" id="sim">
    <h2 class="topic__heading">{{ topic.sim.title }}</h2>
    <p class="sim__intro">{{ topic.sim.intro }}</p>

    <div class="sim__controls">
      {% for c in topic.sim.controls %}
      <label class="sim__control">
        <span class="sim__control-head">
          <span>{{ c.label }}</span>
          <output id="out-{{ c.key }}" class="ltr"></output>
        </span>
        <input type="range" id="in-{{ c.key }}"
               min="{{ c.min }}" max="{{ c.max }}" step="{{ c.step }}" value="{{ c.value }}">
      </label>
      {% endfor %}
    </div>

    <div class="sim__chart">
      <svg id="e-svg" viewBox="0 0 640 300" role="img" aria-label="שתי עקומות התכנסות אל e: הגבול מטפס לאט, הטור מגיע כמעט מיד" preserveAspectRatio="none">
        <line x1="0" y1="20" x2="640" y2="20" class="sim__line--simple" stroke-dasharray="4 4"/>
        <polyline id="e-limit" class="sim__line sim__line--simple" fill="none"/>
        <polyline id="e-series" class="sim__line sim__line--compound" fill="none"/>
      </svg>
      <p class="sim__axis">מספר הצעדים <span class="ltr">1 → 13</span>. הקו המקווקו העליון הוא e.</p>
    </div>

    <div class="sim__readout">
      <div class="sim__stat">
        <span class="sim__stat-label">הגבול, n חלוקות</span>
        <span class="sim__stat-value ltr" id="e-out-limit"></span>
      </div>
      <div class="sim__stat sim__stat--strong">
        <span class="sim__stat-label">הטור, מחוברים</span>
        <span class="sim__stat-value ltr" id="e-out-series"></span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">e</span>
        <span class="sim__stat-value ltr">2.7182818285</span>
      </div>
      <div class="sim__stat">
        <span class="sim__stat-label">פעולות שנדרשו</span>
        <span class="sim__stat-value ltr" id="e-out-cost"></span>
      </div>
    </div>
    <p class="sim__note" id="e-note"></p>
  </section>
  {% endif %}

  {% if topic.sim and topic.sim.type == 'crispr-target' %}
  <section class="sim" id="sim">
    <h2 class="topic__heading">{{ topic.sim.title }}</h2>
    <p class="sim__intro">{{ topic.sim.intro }}</p>

    <p class="crispr-guide-line">
      <span class="crispr-guide-line__label">המדריך</span>
      <span class="ltr crispr-mono" id="crispr-guide">{{ topic.sim.guide }}</span>
    </p>

    <div class="sim__controls">
      <label class="sim__control">
        <span class="sim__control-head">
          <span>כמה אי־התאמות החלבון סובל</span>
          <output id="out-mm" class="ltr"></output>
        </span>
        <input type="range" id="in-mm" min="0" max="4" step="1" value="0">
      </label>
    </div>

    <div class="crispr-genome crispr-mono" id="crispr-genome"
         data-genome="{{ topic.sim.genome }}" data-guide="{{ topic.sim.guide }}"></div>

    <table class="crispr-hits">
      <thead>
        <tr>
          <th>מיקום</th>
          <th>אי־התאמות</th>
          <th>הקרובה ביותר ל-PAM</th>
          <th>PAM</th>
          <th>תוצאה</th>
        </tr>
      </thead>
      <tbody id="crispr-hits"></tbody>
    </table>

    <p class="sim__note" id="crispr-note"></p>
    <p class="sim__note euv-caveat">{{ topic.sim.caveat }}</p>
  </section>
  {% endif %}

  {% if topic.quiz %}
  <section class="quiz" id="quiz">
    <h2 class="topic__heading">בדקו את עצמכם</h2>
    <form id="quiz-form">
      {% for q in topic.quiz %}
      {% set qi = loop.index0 %}
      <fieldset class="quiz__q" data-answer="{{ q.answer }}">
        <legend class="quiz__legend"><span class="quiz__num">{{ loop.index }}</span>{{ q.q }}</legend>
        {% for opt in q.options %}
        <label class="quiz__opt">
          <input type="radio" name="q{{ qi }}" value="{{ loop.index0 }}">
          <span>{{ opt }}</span>
        </label>
        {% endfor %}
        <p class="quiz__why">{{ q.why }}</p>
      </fieldset>
      {% endfor %}
      <div class="quiz__actions">
        <button type="button" id="quiz-check" class="quiz__btn">בדקו את התשובות</button>
        <button type="button" id="quiz-reset" class="quiz__btn quiz__btn--ghost">נקו</button>
        <p class="quiz__score" id="quiz-score" role="status"></p>
      </div>
    </form>
  </section>
  {% endif %}

  {% if topic.takeaways %}
  <section class="takeaways">
    <h2 class="topic__heading">מה חשוב לזכור</h2>
    <ul class="takeaways__list">
      {% for t in topic.takeaways %}
      <li>{{ t }}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</article>

<script>
/* ===== מדמה חיפוש מטרה של CRISPR ===== */
(function () {
  var host = document.getElementById('crispr-genome');
  if (!host) return;

  var genome = host.getAttribute('data-genome') || '';
  var guide = host.getAttribute('data-guide') || '';
  var G = guide.length;
  var slider = document.getElementById('in-mm');
  var out = document.getElementById('out-mm');
  var rows = document.getElementById('crispr-hits');
  var note = document.getElementById('crispr-note');

  // A site is worth showing if the protein could plausibly reach it: either a
  // near match with a PAM, or a perfect match without one. The second case is
  // the whole point of the exercise, so it is never filtered out.
  var sites = [];
  for (var i = 0; i + G + 3 <= genome.length; i++) {
    var seq = genome.substr(i, G);
    var pam = genome.substr(i + G, 3);
    var hasPam = pam.charAt(1) === 'G' && pam.charAt(2) === 'G';
    var mm = 0, near = null;
    for (var j = 0; j < G; j++) {
      if (seq.charAt(j) !== guide.charAt(j)) {
        mm++;
        near = G - j;
      }
    }
    if ((hasPam && mm <= 4) || mm === 0) {
      sites.push({ at: i, seq: seq, pam: pam, hasPam: hasPam, mm: mm, near: near });
    }
  }
  sites.sort(function (a, b) { return a.mm - b.mm || a.at - b.at; });

  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }

  // The count of mismatches is not the whole rule. The stretch of about ten
  // letters next to the PAM is checked first, and a mismatch there usually stops
  // the protein, while the same mismatch at the far end is often tolerated. A
  // simulator that only counted mismatches would contradict the section above it.
  var SEED = 10;
  function cuts(s, tol) {
    return s.hasPam && s.mm <= tol && (s.mm === 0 || s.near > SEED);
  }

  function draw() {
    var tol = parseInt(slider.value, 10);
    var cut = sites.filter(function (s) { return cuts(s, tol); });
    var cutAt = {};
    cut.forEach(function (s) { cutAt[s.at] = true; });

    var html = '', pos = 0;
    sites.slice().sort(function (a, b) { return a.at - b.at; }).forEach(function (s) {
      if (s.at < pos) return;
      html += esc(genome.slice(pos, s.at));
      var cls = cutAt[s.at] ? 'crispr-site crispr-site--cut'
              : (s.hasPam ? 'crispr-site' : 'crispr-site crispr-site--nopam');
      html += '<span class="' + cls + '">' + esc(s.seq) + '</span>';
      html += '<span class="crispr-pam-mark' + (s.hasPam ? '' : ' crispr-pam-mark--absent') + '">'
           + esc(s.pam) + '</span>';
      pos = s.at + G + 3;
    });
    html += esc(genome.slice(pos));
    host.innerHTML = html;

    out.textContent = tol;
    rows.innerHTML = sites.map(function (s) {
      var willCut = cuts(s, tol);
      var verdict = !s.hasPam ? 'אין PAM, אין חיתוך'
                  : (willCut ? (s.mm === 0 ? 'האתר המבוקש' : 'חיתוך לא מכוון')
                    : (s.mm <= tol ? 'אי־ההתאמה צמודה ל-PAM. נעצר' : 'יותר מדי אי־התאמות'));
      return '<tr class="' + (willCut ? 'is-cut' : '') + '">'
        + '<td class="ltr">' + s.at + '</td>'
        + '<td class="ltr">' + s.mm + '</td>'
        + '<td class="ltr">' + (s.near === null ? '' : s.near) + '</td>'
        + '<td class="ltr">' + esc(s.pam) + '</td>'
        + '<td>' + verdict + '</td>'
        + '</tr>';
    }).join('');

    var extra = cut.length - 1;
    if (tol === 0) {
      note.textContent = 'בסובלנות אפס נחתך אתר אחד בלבד. שימו לב לאתר השני ברשימה: '
        + 'הוא מתאים למדריך בכל עשרים האותיות, ובכל זאת אינו נחתך, כי אחריו אין PAM.';
    } else if (extra <= 0) {
      note.textContent = 'עדיין אתר אחד. באתר הדומה השני אי־ההתאמות צמודות ל-PAM, ושם החלבון עוצר.';
    } else {
      note.textContent = 'בסובלנות של ' + tol + ' אי־התאמות נחתך אתר נוסף שלא התכוונו אליו. '
        + 'ברצף של 196 אותיות זה נראה מעט. בגנום של שלושה מיליארד אותיות, זה מה שנקרא off-target.';
    }
  }

  slider.addEventListener('input', draw);
  draw();
})();
</script>

<script>
/* ===== מדמה ריבית דריבית ===== */
(function () {
  var svg = document.getElementById('sim-svg');
  if (!svg) return;

  var W = 640, H = 300, PAD = 8;
  var keys = ['principal', 'rate', 'years', 'monthly'];
  var inputs = {}, outs = {};
  keys.forEach(function (k) {
    inputs[k] = document.getElementById('in-' + k);
    outs[k] = document.getElementById('out-' + k);
  });
  if (!inputs.principal) return;

  var fmt = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });

  function series(P, r, years, monthly) {
    var simple = [], compound = [], paid = [];
    var comp = P, totalPaid = P;
    for (var t = 0; t <= years; t++) {
      if (t > 0) {
        comp = comp * (1 + r);
        // הפקדות חודשיות נצברות במהלך השנה וגם הן צוברות ריבית
        for (var m = 0; m < 12; m++) comp += monthly * Math.pow(1 + r, (12 - m - 1) / 12);
        totalPaid += monthly * 12;
      }
      simple.push(P * (1 + r * t) + monthly * 12 * t);
      compound.push(comp);
      paid.push(totalPaid);
    }
    return { simple: simple, compound: compound, paid: paid };
  }

  function points(arr, max, years) {
    var n = arr.length - 1;
    return arr.map(function (v, i) {
      var x = PAD + (i / Math.max(n, 1)) * (W - PAD * 2);
      var y = H - PAD - (v / max) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    }).join(' ');
  }

  function render() {
    var P = +inputs.principal.value;
    var rPct = +inputs.rate.value;
    var years = +inputs.years.value;
    var monthly = +inputs.monthly.value;
    var r = rPct / 100;

    outs.principal.textContent = fmt.format(P) + ' ₪';
    outs.rate.textContent = rPct + '%';
    outs.years.textContent = years + ' שנים';
    outs.monthly.textContent = monthly ? fmt.format(monthly) + ' ₪' : 'ללא';

    var s = series(P, r, years, monthly);
    var max = Math.max(s.compound[years], s.simple[years]) * 1.05 || 1;

    document.getElementById('sim-simple').setAttribute('points', points(s.simple, max, years));
    document.getElementById('sim-compound').setAttribute('points', points(s.compound, max, years));

    var fin = s.compound[years], sim = s.simple[years];
    document.getElementById('sim-out-simple').textContent = fmt.format(Math.round(sim)) + ' ₪';
    document.getElementById('sim-out-compound').textContent = fmt.format(Math.round(fin)) + ' ₪';
    document.getElementById('sim-out-gap').textContent = fmt.format(Math.round(fin - sim)) + ' ₪';
    document.getElementById('sim-out-paid').textContent = fmt.format(Math.round(s.paid[years])) + ' ₪';
    document.getElementById('sim-years-axis').textContent = '0 – ' + years;

    var note = document.getElementById('sim-note');
    var times = s.paid[years] ? fin / s.paid[years] : 0;
    var rule72 = rPct > 0 ? (72 / rPct) : 0;
    note.textContent = 'בריבית של ' + rPct + '% הכסף מכפיל את עצמו בערך כל '
      + rule72.toFixed(1) + ' שנים (כלל 72). אחרי ' + years + ' שנים היתרה גדולה פי '
      + times.toFixed(1) + ' מסך מה שהפקדתם.';
  }

  keys.forEach(function (k) { inputs[k].addEventListener('input', render); });
  render();
})();

/* ===== מדמה ההתכנסות אל e ===== */
(function () {
  var svg = document.getElementById('e-svg');
  if (!svg) return;

  var W = 640, H = 300, PAD = 8;
  var E = Math.E, STEPS = 13;
  var inN = document.getElementById('in-nexp');
  var inT = document.getElementById('in-terms');
  if (!inN || !inT) return;

  function limitAt(n) { return Math.pow(1 + 1 / n, n); }

  function seriesAt(terms) {
    var s = 0, f = 1;
    for (var k = 0; k < terms; k++) {
      if (k > 0) f *= k;
      s += 1 / f;
    }
    return s;
  }

  /* שתי העקומות מצוירות על אותו ציר צעדים כדי שההשוואה תהיה הוגנת: צעד אחד
     בגבול הוא חלוקה נוספת, צעד אחד בטור הוא מחובר נוסף. תחתית הגרף היא 1.8
     ולא אפס, אחרת כל ההבדל המעניין נדחס לפס דק. */
  function points(fn) {
    var lo = 1.8, hi = E + (E - lo) * 0.08;
    var out = [];
    for (var i = 1; i <= STEPS; i++) {
      var v = Math.min(fn(i), hi);
      var x = PAD + ((i - 1) / (STEPS - 1)) * (W - PAD * 2);
      var y = H - PAD - ((v - lo) / (hi - lo)) * (H - PAD * 2);
      out.push(x.toFixed(1) + ',' + Math.min(Math.max(y, PAD), H - PAD).toFixed(1));
    }
    return out.join(' ');
  }

  document.getElementById('e-limit').setAttribute('points', points(limitAt));
  document.getElementById('e-series').setAttribute('points', points(seriesAt));

  var fmtInt = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });

  function render() {
    var n = Math.pow(10, +inN.value);
    var terms = +inT.value;
    var lim = limitAt(n), ser = seriesAt(terms);

    document.getElementById('out-nexp').textContent = 'n = ' + fmtInt.format(n);
    document.getElementById('out-terms').textContent = terms;
    document.getElementById('e-out-limit').textContent = lim.toFixed(10);
    document.getElementById('e-out-series').textContent = ser.toFixed(10);
    document.getElementById('e-out-cost').textContent =
      fmtInt.format(n) + ' מול ' + terms;

    /* ספרות נכונות אחרי הנקודה, לפי גודל השגיאה */
    function digits(v) {
      var err = Math.abs(v - E);
      return err === 0 ? 12 : Math.max(0, Math.floor(-Math.log10(err)));
    }
    document.getElementById('e-note').textContent =
      'ספרות נכונות אחרי הנקודה: הגבול עם ' + fmtInt.format(n) + ' חלוקות, '
      + digits(lim) + '. הטור עם ' + terms + ' מחוברים, ' + digits(ser) + '.';
  }

  inN.addEventListener('input', render);
  inT.addEventListener('input', render);
  render();
})();

/* ===== בוחן ===== */
(function () {
  var form = document.getElementById('quiz-form');
  if (!form) return;
  var qs = Array.prototype.slice.call(form.querySelectorAll('.quiz__q'));
  var scoreEl = document.getElementById('quiz-score');

  document.getElementById('quiz-check').addEventListener('click', function () {
    var right = 0, answered = 0;
    qs.forEach(function (q) {
      var correct = +q.dataset.answer;
      var picked = q.querySelector('input:checked');
      q.classList.remove('is-right', 'is-wrong');
      if (!picked) return;
      answered++;
      if (+picked.value === correct) { q.classList.add('is-right'); right++; }
      else { q.classList.add('is-wrong'); }
      q.querySelectorAll('.quiz__opt').forEach(function (opt, i) {
        opt.classList.toggle('is-answer', i === correct);
      });
    });
    if (!answered) { scoreEl.textContent = 'בחרו תשובה לפחות בשאלה אחת.'; return; }
    scoreEl.textContent = 'ענית נכון על ' + right + ' מתוך ' + qs.length + '.';
  });

  document.getElementById('quiz-reset').addEventListener('click', function () {
    form.reset();
    qs.forEach(function (q) {
      q.classList.remove('is-right', 'is-wrong');
      q.querySelectorAll('.quiz__opt').forEach(function (o) { o.classList.remove('is-answer'); });
    });
    scoreEl.textContent = '';
  });
})();

/* ===== מדמה רזולוציה ליתוגרפית: CD = k1 · λ / NA ===== */
(function () {
  var svg = document.getElementById('euv-svg');
  if (!svg) return;

  var naIn = document.getElementById('in-na');
  var k1In = document.getElementById('in-k1');
  var naOut = document.getElementById('out-na');
  var k1Out = document.getElementById('out-k1');
  var linesG = document.getElementById('euv-lines');
  var blurNode = document.getElementById('euv-blur-node');
  var btns = Array.prototype.slice.call(document.querySelectorAll('.euv-source-btn'));
  if (!naIn || !btns.length) return;

  var W = 640, H = 190;
  var lambda = +btns[0].dataset.lambda;
  var naMax = +btns[0].dataset.namax;

  function cd(lam, na, k1) { return k1 * lam / na; }

  function draw() {
    var na = Math.min(+naIn.value, naMax);
    var k1 = +k1In.value;
    var res = cd(lambda, na, k1);

    naOut.textContent = na.toFixed(2);
    k1Out.textContent = k1.toFixed(2);

    // רוחב הקו על המסך פרופורציוני לרוחב האמיתי, בסקאלה קבועה
    var nmPerPx = 0.9;                       // 640 פיקסלים = 576 ננומטר
    var wpx = Math.max(1.2, res / nmPerPx);
    var pitch = wpx * 2;
    var n = Math.ceil(W / pitch) + 1;

    var out = '';
    for (var i = 0; i < n; i++) {
      out += '<rect x="' + (i * pitch).toFixed(2) + '" y="18" width="' +
             wpx.toFixed(2) + '" height="' + (H - 36) + '" class="euv-line"/>';
    }
    linesG.innerHTML = out;

    // ככל שהקו מתקרב לגבול הפיזיקלי הוא נמרח. k1 נמוך = תהליך אגרסיבי = פחות חד.
    // הטשטוש נחסם, אחרת קווים רחבים נראים מרוחים הרבה מעבר למה שהכוונה להמחיש
    var sharp = Math.max(0, Math.min(1, (k1 - 0.25) / 0.20));
    blurNode.setAttribute('stdDeviation',
      Math.min(wpx * (1 - sharp) * 0.28, 4.5).toFixed(2));

    document.getElementById('euv-out-cd').textContent = res.toFixed(1) + ' nm';
    document.getElementById('euv-out-lambda').textContent = lambda + ' nm';
    document.getElementById('euv-scale').textContent =
      'רוחב התמונה כאן הוא כ-' + Math.round(W * nmPerPx) + ' ננומטר';

    // ההשוואה ל-DUV נעשית בתנאים הטובים ביותר שיש לו: טבילה במים, NA 1.35
    var duv = cd(193, 1.35, k1);
    document.getElementById('euv-out-duv').textContent = duv.toFixed(1) + ' nm';

    // כל מעבר הדפסה נוסף חוצה בקירוב את הצפיפות
    var passes = duv <= res ? 1 : Math.pow(2, Math.ceil(Math.log(duv / res) / Math.log(2)));
    document.getElementById('euv-out-passes').textContent =
      lambda === 193 ? '—' : '×' + passes;

    var note = document.getElementById('euv-note');
    if (lambda === 193) {
      note.textContent = 'ב-193 ננומטר צריך צמצם גדול מ-1, וזה אפשרי רק כשממלאים ' +
        'את המרווח שבין העדשה לפרוסה במים. זה מה שנקרא ליתוגרפיית טבילה.';
    } else {
      note.textContent = 'קיצור אורך הגל פי כ-14 קונה את אותה רזולוציה בלי צמצם ענק ' +
        'ובלי לחזור על ההדפסה. זו כל התכלית של EUV.';
    }
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      btns.forEach(function (o) { o.classList.remove('is-active'); });
      b.classList.add('is-active');
      lambda = +b.dataset.lambda;
      naMax = +b.dataset.namax;
      naIn.max = naMax;
      // כל מקור אור מגיע עם הצמצם האופייני לו, אחרת ההשוואה חסרת משמעות
      naIn.value = b.dataset.natypical;
      draw();
    });
  });
  [naIn, k1In].forEach(function (el) { el.addEventListener('input', draw); });
  naIn.max = naMax;
  draw();
})();
</script>
{% endblock %}
