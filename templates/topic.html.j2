{% extends "_shell.html.j2" %}

{% block page_title %}{{ topic.title }}{% endblock %}
{% block section_label %}לומדים היום{% endblock %}

{% block content %}
<article class="topic">

  <header class="topic__head">
    <p class="topic__level">{{ topic.level }}{% if topic.reading_minutes %} · קריאה של {{ topic.reading_minutes }} דקות{% endif %}</p>
    <h1 class="topic__title">{{ topic.title }}</h1>
    {% if topic.subtitle %}<p class="topic__subtitle">{{ topic.subtitle }}</p>{% endif %}
    <p class="topic__summary">{{ topic.summary }}</p>
    {% if topic.edition %}
    <p class="topic__origin">
      פורסם לראשונה במהדורת <a href="{{ base }}editions/{{ topic.edition }}.html">{{ topic.date_long | default(topic.edition) }}</a>
    </p>
    {% endif %}
  </header>

  {% for sec in topic.sections %}
  <section class="topic__section">
    <h2 class="topic__heading">{{ sec.heading }}</h2>
    {% for p in sec.paras %}
    <p>{{ p }}</p>
    {% endfor %}

    {% if sec.formula %}
    <div class="formula">
      <p class="formula__label">{{ sec.formula.label }}</p>
      {% for line in sec.formula.lines %}
      <p class="formula__line">
        <span class="formula__name">{{ line.name }}</span>
        <span class="formula__expr ltr">{{ line.expr }}</span>
      </p>
      {% endfor %}
      <p class="formula__legend">{{ sec.formula.legend }}</p>
    </div>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'gene-anatomy' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 300" role="img" aria-label="למעלה, קטע DNA ישר שבו האנהנסר רחוק מהפרומוטור ומהגן. למטה, אותו קטע מקופל ללולאה שמצמידה את האנהנסר לפרומוטור" preserveAspectRatio="xMidYMid meet">
        <text x="500" y="24" class="diagram__label diagram__label--strong">על הרצף</text>
        <line x1="40" y1="70" x2="480" y2="70" class="diagram__axis"/>
        <rect x="62" y="58" width="74" height="24" class="diagram__dot"/>
        <text x="99" y="102" class="diagram__axis-label">אנהנסר</text>
        <rect x="330" y="58" width="34" height="24" class="diagram__dot"/>
        <text x="347" y="102" class="diagram__axis-label">פרומוטור</text>
        <rect x="364" y="58" width="104" height="24" class="diagram__dot diagram__dot--strong"/>
        <text x="416" y="102" class="diagram__axis-label">הגן</text>
        <text x="233" y="50" class="diagram__label">עשרות אלפי אותיות</text>

        <text x="500" y="164" class="diagram__label diagram__label--strong">במרחב, בתוך הגרעין</text>
        <path class="diagram__exp" d="M120,210 C120,140 340,140 340,210"/>
        <line x1="40" y1="210" x2="480" y2="210" class="diagram__axis"/>
        <rect x="96" y="198" width="48" height="24" class="diagram__dot"/>
        <rect x="316" y="198" width="34" height="24" class="diagram__dot"/>
        <rect x="350" y="198" width="104" height="24" class="diagram__dot diagram__dot--strong"/>
        <text x="120" y="248" class="diagram__axis-label">אנהנסר</text>
        <text x="333" y="248" class="diagram__axis-label">פרומוטור</text>
        <text x="402" y="248" class="diagram__axis-label">הגן</text>
        <text x="230" y="132" class="diagram__label">הלולאה מקרבת ביניהם</text>
        <text x="260" y="284" class="diagram__axis-label">אותו רצף. מרחק אחר.</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'genome-ruler' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 200" role="img" aria-label="סרגל שמייצג את הגנום האנושי. פס דק בקצה מסמן את שני האחוזים שמקודדים חלבון, ושאר הסרגל הוא הרצף הלא מקודד" preserveAspectRatio="xMidYMid meet">
        <rect x="40" y="70" width="440" height="46" class="diagram__dot"/>
        <rect x="40" y="70" width="9" height="46" class="diagram__dot diagram__dot--strong"/>
        <line x1="44" y1="70" x2="44" y2="40" class="diagram__axis"/>
        <text x="150" y="34" class="diagram__label diagram__label--strong">כ-2% מקודדים חלבון</text>
        <text x="270" y="100" class="diagram__label">כ-98% אינם מקודדים חלבון</text>
        <text x="60" y="146" class="diagram__axis-label">3,300,000,000 אותיות</text>
        <text x="382" y="146" class="diagram__axis-label">המקור: מכון המחקר הלאומי לגנום האנושי</text>
        <text x="270" y="178" class="diagram__axis-label">לא מקודד אינו שם נרדף למתפקד, וגם לא לזבל</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'linear-vs-exponential' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="השוואה בין גדילה לינארית לגדילה מעריכית" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <polyline class="diagram__linear" points="52,220 500,150"/>
        <path class="diagram__exp" d="M52,220 C210,214 330,190 420,120 S488,44 500,26"/>
        <circle cx="500" cy="150" r="4" class="diagram__dot"/>
        <circle cx="500" cy="26" r="4" class="diagram__dot diagram__dot--strong"/>
        <text x="492" y="168" class="diagram__label">ריבית פשוטה</text>
        <text x="492" y="18" class="diagram__label diagram__label--strong">ריבית דריבית</text>
        <text x="276" y="248" class="diagram__axis-label">זמן ←</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'e-limit-steps' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="ערך הסכום כשמחלקים את השנה למספר גדל של תקופות ריבית, מתקרב ל-e ולא עובר אותו" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <line x1="52" y1="44" x2="500" y2="44" class="diagram__linear"/>
        <text x="496" y="36" class="diagram__label diagram__label--strong">e = 2.71828</text>
        <rect x="74"  y="164" width="40" height="56"  class="diagram__dot"/>
        <rect x="150" y="128" width="40" height="92"  class="diagram__dot"/>
        <rect x="226" y="72"  width="40" height="148" class="diagram__dot"/>
        <rect x="302" y="49"  width="40" height="171" class="diagram__dot"/>
        <rect x="378" y="45"  width="40" height="175" class="diagram__dot diagram__dot--strong"/>
        <text x="94"  y="238" class="diagram__axis-label">1</text>
        <text x="170" y="238" class="diagram__axis-label">2</text>
        <text x="246" y="238" class="diagram__axis-label">12</text>
        <text x="322" y="238" class="diagram__axis-label">365</text>
        <text x="398" y="238" class="diagram__axis-label">8760</text>
        <text x="94"  y="156" class="diagram__label">2.00</text>
        <text x="170" y="120" class="diagram__label">2.25</text>
        <text x="246" y="64"  class="diagram__label">2.613</text>
        <text x="322" y="41"  class="diagram__label">2.7146</text>
        <text x="276" y="256" class="diagram__axis-label">מספר חלוקות בשנה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'e-derivative' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 260" role="img" aria-label="הפונקציה e בחזקת x, ומשיק שהשיפוע שלו שווה לגובה הפונקציה באותה נקודה" preserveAspectRatio="xMidYMid meet">
        <line x1="52" y1="220" x2="500" y2="220" class="diagram__axis"/>
        <line x1="52" y1="220" x2="52" y2="20" class="diagram__axis"/>
        <path class="diagram__exp" d="M52,214 C160,210 250,196 330,164 S440,74 480,26"/>
        <line x1="286" y1="220" x2="286" y2="182" class="diagram__linear"/>
        <line x1="212" y1="220" x2="360" y2="144" class="diagram__linear"/>
        <circle cx="286" cy="182" r="4" class="diagram__dot diagram__dot--strong"/>
        <text x="300" y="176" class="diagram__label diagram__label--strong">גובה = שיפוע</text>
        <text x="470" y="20"  class="diagram__label">y = e^x</text>
        <text x="276" y="248" class="diagram__axis-label">x ←</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-wavelength' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="השוואה בסקאלה בין אורכי גל של אור נראה, DUV ו-EUV, ובין גודל הפרט שמדפיסים" preserveAspectRatio="xMidYMid meet">
        <text x="520" y="30" class="diagram__label diagram__label--strong">אור נראה · כ-550 ננומטר</text>
        <rect x="80" y="38" width="440" height="14" class="euv-bar euv-bar--faint"/>
        <text x="520" y="80" class="diagram__label diagram__label--strong">DUV · 193 ננומטר</text>
        <rect x="366" y="88" width="154" height="14" class="euv-bar"/>
        <text x="520" y="130" class="diagram__label diagram__label--strong">EUV · 13.5 ננומטר</text>
        <rect x="509" y="138" width="11" height="14" class="euv-bar euv-bar--strong"/>
        <text x="520" y="180" class="diagram__label">הפרט שרוצים להדפיס · כ-20 ננומטר</text>
        <rect x="504" y="188" width="16" height="14" class="euv-bar euv-bar--feature"/>
        <line x1="80" y1="216" x2="520" y2="216" class="diagram__axis"/>
        <text x="300" y="238" class="diagram__axis-label">הכול באותה סקאלה. הפרט קטן מאורך הגל של DUV פי כמעט עשרה, וזה כל הקושי</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-source' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 260" role="img" aria-label="שלושת שלבי יצירת האור: טיפת בדיל, פולס משטח, ופולס שני שמאייד אותה לפלזמה קורנת" preserveAspectRatio="xMidYMid meet">
        <text x="548" y="40" class="diagram__label diagram__label--strong">1 · טיפת בדיל נופלת</text>
        <line x1="300" y1="10" x2="300" y2="22" class="euv-arrow"/>
        <circle cx="300" cy="36" r="9" class="euv-drop"/>

        <text x="548" y="116" class="diagram__label diagram__label--strong">2 · פולס לייזר משטח אותה</text>
        <ellipse cx="300" cy="112" rx="18" ry="5" class="euv-drop"/>
        <line x1="180" y1="112" x2="272" y2="112" class="euv-laser"/>
        <text x="170" y="108" class="diagram__label">לייזר</text>

        <text x="548" y="182" class="diagram__label diagram__label--strong">3 · פולס שני מאייד אותה לפלזמה</text>
        <text x="548" y="202" class="diagram__label">קרינה ב-13.5 ננומטר לכל הכיוונים</text>
        <line x1="170" y1="186" x2="264" y2="186" class="euv-laser euv-laser--strong"/>
        <circle cx="300" cy="186" r="27" class="euv-plasma euv-plasma--outer"/>
        <circle cx="300" cy="186" r="16" class="euv-plasma"/>
        <circle cx="300" cy="186" r="6" class="euv-plasma-core"/>
        <line x1="332" y1="186" x2="346" y2="186" class="euv-beam euv-beam--faint"/>
        <line x1="322.6" y1="163.4" x2="332.5" y2="153.5" class="euv-beam euv-beam--faint"/>
        <line x1="300" y1="154" x2="300" y2="140" class="euv-beam euv-beam--faint"/>
        <line x1="277.4" y1="163.4" x2="267.5" y2="153.5" class="euv-beam euv-beam--faint"/>
        <line x1="277.4" y1="208.6" x2="267.5" y2="218.5" class="euv-beam euv-beam--faint"/>
        <line x1="300" y1="218" x2="300" y2="232" class="euv-beam euv-beam--faint"/>
        <line x1="322.6" y1="208.6" x2="332.5" y2="218.5" class="euv-beam euv-beam--faint"/>
        <text x="300" y="252" class="diagram__axis-label">עשרות אלפי טיפות בשנייה. את הקרינה אוספת מראה קעורה ושולחת אותה אל המסכה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'euv-mirror' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="מראת ברג רב-שכבתית: שכבות מוליבדן וסיליקון, שכל ממשק ביניהן מחזיר שבריר מהאור" preserveAspectRatio="xMidYMid meet">
        {% for i in range(9) %}
        <rect x="90" y="{{ 66 + i * 18 }}" width="300" height="9" class="euv-layer euv-layer--mo"/>
        <rect x="90" y="{{ 75 + i * 18 }}" width="300" height="9" class="euv-layer euv-layer--si"/>
        {% endfor %}

        <rect x="500" y="64" width="14" height="10" class="euv-layer euv-layer--mo"/>
        <text x="494" y="73" class="diagram__label">מוליבדן</text>
        <rect x="500" y="84" width="14" height="10" class="euv-layer euv-layer--si"/>
        <text x="494" y="93" class="diagram__label">סיליקון</text>

        <text x="548" y="18" class="diagram__label diagram__label--strong">אור נכנס</text>
        <line x1="470" y1="20" x2="330" y2="66" class="euv-beam"/>
        {% for i in range(5) %}
        <line x1="{{ 330 - i * 6 }}" y1="{{ 66 + i * 36 }}" x2="{{ 415.5 - i * 6 }}" y2="{{ 38 + i * 36 }}" class="euv-beam euv-beam--faint"/>
        {% endfor %}
        <text x="300" y="244" class="diagram__axis-label">עשרות זוגות שכבות בעובי ננומטרים. כל ממשק מחזיר מעט, וההחזרות מתחברות בפאזה</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}
    {% if sec.diagram and sec.diagram.type == 'crispr-parts' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 250" role="img" aria-label="מדריך RNA נצמד לרצף המטרה על גדיל ה-DNA, החלבון אוחז בו, ורצף PAM צמוד מאפשר את החיתוך" preserveAspectRatio="xMidYMid meet">
        <path class="crispr-protein" d="M150,104 L300,88 L450,104 L462,168 L440,214 L300,226 L160,214 L138,168 Z"/>
        <text x="330" y="112" class="diagram__axis-label">Cas9</text>

        <line x1="30" y1="158" x2="530" y2="158" class="crispr-strand"/>
        <line x1="30" y1="190" x2="530" y2="190" class="crispr-strand"/>
        <rect x="180" y="152" width="210" height="12" class="crispr-target"/>
        <rect x="390" y="152" width="31" height="12" class="crispr-pam"/>

        <line x1="180" y1="132" x2="390" y2="132" class="crispr-guide"/>
        {% for i in range(20) %}
        <line x1="{{ 185.25 + i * 10.5 }}" y1="136" x2="{{ 185.25 + i * 10.5 }}" y2="152" class="crispr-pair"/>
        {% endfor %}
        <text x="176" y="128" class="diagram__label diagram__label--strong">מדריך RNA · 20 אותיות</text>

        <line x1="358.5" y1="144" x2="358.5" y2="204" class="crispr-cut"/>
        <text x="352" y="216" class="diagram__label">חיתוך בשני הגדילים</text>

        <text x="405" y="146" class="diagram__axis-label">PAM</text>
        <text x="285" y="180" class="diagram__axis-label">רצף המטרה</text>
        <text x="280" y="243" class="diagram__axis-label">בלי PAM צמוד אין חיתוך</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'crispr-repair' %}
    <figure class="diagram">
      <svg viewBox="0 0 560 260" role="img" aria-label="שבר בשני גדילי הדנא ושני מסלולי התיקון: חיבור מהיר שמשאיר שגיאה, והעתקה מתבנית שכותבת את הרצף הרצוי" preserveAspectRatio="xMidYMid meet">
        <text x="332" y="24" class="diagram__label diagram__label--strong">שבר בשני הגדילים</text>
        <line x1="180" y1="44" x2="268" y2="44" class="crispr-strand"/>
        <line x1="180" y1="58" x2="268" y2="58" class="crispr-strand"/>
        <line x1="292" y1="44" x2="380" y2="44" class="crispr-strand"/>
        <line x1="292" y1="58" x2="380" y2="58" class="crispr-strand"/>

        <line x1="252" y1="76" x2="150" y2="112" class="crispr-arrow"/>
        <line x1="308" y1="76" x2="410" y2="112" class="crispr-arrow"/>

        <text x="268" y="106" class="diagram__label diagram__label--strong">חיבור מהיר</text>
        <line x1="40" y1="150" x2="268" y2="150" class="crispr-strand"/>
        <line x1="40" y1="164" x2="268" y2="164" class="crispr-strand"/>
        <rect x="148" y="144" width="9" height="26" class="crispr-indel"/>
        <text x="268" y="192" class="diagram__label">אות נוספת או חסרה</text>
        <text x="268" y="212" class="diagram__label diagram__label--strong">מסגרת הקריאה זזה. הגן מכובה</text>

        <text x="520" y="106" class="diagram__label diagram__label--strong">העתקה מתבנית</text>
        <line x1="330" y1="126" x2="500" y2="126" class="crispr-template"/>
        <text x="520" y="140" class="diagram__label">תבנית עם הרצף הרצוי</text>
        <line x1="292" y1="164" x2="520" y2="164" class="crispr-strand"/>
        <line x1="292" y1="178" x2="520" y2="178" class="crispr-strand"/>
        <rect x="398" y="158" width="26" height="26" class="crispr-written"/>
        <text x="520" y="212" class="diagram__label diagram__label--strong">הרצף נכתב בדיוק כפי שתוכנן</text>

        <text x="280" y="248" class="diagram__axis-label">המהיר זמין תמיד. המדויק דורש תבנית</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'complex-plane-point' %}
    <figure class="diagram">
      <svg viewBox="0 0 520 280" role="img" aria-label="המישור המרוכב עם הנקודה שלוש ועוד שתי i, ושתי הקריאות שלה: קואורדינטות שלוש ושתיים, או גודל 3.606 בזווית 33.69 מעלות" preserveAspectRatio="xMidYMid meet">
        <line x1="40" y1="220" x2="480" y2="220" class="diagram__axis"/>
        <line x1="120" y1="40" x2="120" y2="264" class="diagram__axis"/>
        <text x="450" y="242" class="diagram__axis-label">ציר ממשי</text>
        <text x="160" y="50" class="diagram__axis-label">ציר מדומה</text>

        <line x1="120" y1="220" x2="300" y2="220" class="diagram__linear"/>
        <line x1="300" y1="220" x2="300" y2="100" class="diagram__linear"/>
        <line x1="120" y1="220" x2="300" y2="100" class="diagram__exp"/>
        <path d="M170,220 A50,50 0 0,0 161.6,192.3" class="cplx-arc"/>

        <circle cx="300" cy="100" r="5" class="diagram__dot diagram__dot--strong"/>
        <text x="352" y="94" class="diagram__label diagram__label--strong ltr">3 + 2i</text>

        <text x="210" y="238" class="diagram__label ltr">3</text>
        <text x="314" y="166" class="diagram__label ltr">2</text>
        <text x="196" y="152" class="diagram__label ltr">3.606</text>
        <text x="192" y="210" class="diagram__label ltr">33.69°</text>

        <text x="440" y="272" class="diagram__axis-label">שתי קריאות, נקודה אחת</text>
      </svg>
      <figcaption>{{ sec.diagram.caption }}</figcaption>
    </figure>
    {% endif %}

    {% if sec.diagram and sec.diagram.type == 'complex-rotation' %}
