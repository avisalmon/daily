# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Deep research (lead story) ---
# Personal OpenAI key. Used for o4-mini-deep-research / o3-deep-research.
OPENAI_API_KEY=
DEEP_RESEARCH_MODEL=o4-mini-deep-research

# --- Azure AI (shared Intel deployment, optional) ---
# Available for non-research work only. Never used for the deep-research story.
AZURE_API_KEY=
AZURE_API_BASE=https://oai-modelon-eastus2.cognitiveservices.azure.com
AZURE_API_VERSION=2024-12-01-preview

# --- Podcast (scripts/podcast.py) ---
# One key from https://aistudio.google.com/apikey does both jobs: drafting the
# script and speaking it. Multi-speaker text-to-speech bills audio output at
# 25 tokens per second, so a ten minute episode is roughly $0.30. The free tier
# works for trying it out, with rate limits.
GEMINI_API_KEY=
# Optional overrides. Voices are listed at
# https://ai.google.dev/gemini-api/docs/speech-generation
PODCAST_SCRIPT_MODEL=gemini-3.7-flash
PODCAST_TTS_MODEL=gemini-3.1-flash-tts-preview
PODCAST_VOICE_A=Sulafat
PODCAST_VOICE_B=Sadaltager
# Where the permanent episode archive lives. Defaults to the origin remote.
PODCAST_RELEASE_REPO=

# --- Delivery ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=

# --- Optional source credentials ---
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# --- Runtime ---
LOG_LEVEL=INFO
TIMEZONE=Asia/Jerusalem
